modules = ["python-3.12", "nodejs-20", "web", "postgresql-16"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[userenv]

[userenv.shared]
VITE_API_BASE_URL = ""
VITE_DEMO_ROLE = "junior"
VITE_DEMO_TENANT_ID = "demo-es"
VITE_DEMO_USER_ID = "demo-es-junior"
CONNECTORS_MODE = "live"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd BE-ES-Brokers && bash start.sh"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd FE-ES-Brokers && npm run dev -- --port 5000 --host 0.0.0.0"
waitForPort = 5000

[[ports]]
localPort = 4000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5199
externalPort = 3000

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "cd BE-ES-Brokers && python -m alembic upgrade head && python src/core/seed.py && (uvicorn main:app --app-dir src --host 127.0.0.1 --port 4000 &) && cd ../FE-ES-Brokers && PORT=5000 HOST=0.0.0.0 node .output/server/index.mjs"]
build = ["bash", "-c", "cd FE-ES-Brokers && npm run build"]
